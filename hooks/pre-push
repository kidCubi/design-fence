#!/bin/sh
# design-fence: every pushed commit has its Reflect line, and the checks pass (PROCESS.md, "Enforcement").
if ! command -v node >/dev/null 2>&1; then
  echo "design-fence: node is not on PATH, so the git hooks cannot run. Put Node on PATH; never skip the hooks." >&2
  exit 1
fi
exec node "$(dirname "$0")/../bin/design-fence.mjs" hook pre-push
